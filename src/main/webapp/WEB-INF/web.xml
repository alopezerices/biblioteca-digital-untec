<?xml version="1.0" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  

  <display-name>Biblioteca Digital UNTEC</display-name>
  

  <filter>
    <filter-name>seguridad</filter-name>
    <filter-class>cl.untec.biblioteca.controller.SeguridadFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>seguridad</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  

  <listener>
    <listener-class>cl.untec.biblioteca.config.Bootstrap</listener-class>
  </listener>
  

  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>cl.untec.biblioteca.controller.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  

  <servlet>
    <servlet-name>libros</servlet-name>
    <servlet-class>cl.untec.biblioteca.controller.LibroServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>libros</servlet-name>
    <url-pattern>/libros</url-pattern>
  </servlet-mapping>
  

  <servlet>
    <servlet-name>prestamos</servlet-name>
    <servlet-class>cl.untec.biblioteca.controller.PrestamoServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>prestamos</servlet-name>
    <url-pattern>/prestamos</url-pattern>
  </servlet-mapping>
  

  <servlet>
    <servlet-name>usuarios</servlet-name>
    <servlet-class>cl.untec.biblioteca.controller.UsuarioServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>usuarios</servlet-name>
    <url-pattern>/usuarios</url-pattern>
  </servlet-mapping>
  

  <session-config>
    <session-timeout>20</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
  

  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/view/error.jsp</location>
  </error-page>
  

  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/view/error.jsp</location>
  </error-page>
  

</web-app>
